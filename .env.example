# 复制为 .env 后填写（不要提交到 git）。所有 key 只在服务器端使用。
# Jev（可选）：类型化判断
TYPESAFE_API_KEY=
# 通用 LLM（可选）：AI 建议。任意 OpenAI 兼容服务
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
LLM_REASONING_EFFORT=low
# 登录与跨域
FP_APP_PASSWORD=
FP_SECRET_KEY=
FP_ALLOWED_ORIGINS=https://kenysai.github.io
# 其他
FP_CONFIDENCE_THRESHOLD=0.8
FP_DB_PATH=./data/fp.db
